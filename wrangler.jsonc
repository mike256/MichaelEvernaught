{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "michaelevernaught",
  "compatibility_date": "2024-04-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "build": {
    "command": "",
    "path": "functions",
    "upload_source_maps": false
  },
  "observability": {
    "enabled": true
  }
}
